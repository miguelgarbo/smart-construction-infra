# Diretórios e arquivos locais do Terraform
# Local .terraform directories
.terraform/

# Arquivos de estado (State files)
# É fundamental não versionar arquivos .tfstate, pois podem conter segredos e causar conflitos
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Arquivos de variáveis sensíveis
*.tfvars
*.tfvars.json

# Arquivos de override locais
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Logs de travamento/erro do Terraform
crash.log
crash.*.log

# Arquivos de plano e saída
*tfplan*
*.dot
*.planout

# Configurações de CLI locais
.terraformrc
terraform.rc


.env


# The default root path for Ansible config files on the controller
.ansible/

# Retry files generated for failed Ansible playbook runs
*.retry
terraform/terraform_outputs.json